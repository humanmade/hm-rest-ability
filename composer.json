{
	"name": "humanmade/hm-rest-ability",
	"description": "OAuth2 discovery endpoints and a REST API ability for exposing WordPress to MCP clients via the MCP Adapter",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Human Made",
			"email": "hello@humanmade.com"
		}
	],
	"homepage": "https://github.com/humanmade/hm-rest-ability",
	"support": {
		"issues": "https://github.com/humanmade/hm-rest-ability/issues",
		"source": "https://github.com/humanmade/hm-rest-ability"
	},
	"require": {
		"php": "^7.4 || ^8.0",
		"composer/installers": "^1 || ^2"
	},
	"require-dev": {
		"humanmade/coding-standards": "^2.5",
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"scripts": {
		"lint": "phpcs",
		"format": "phpcbf",
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
