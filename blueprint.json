{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "6.9"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "HM REST Ability"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/releases/download/v0.6.1/mcp-adapter.zip"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "mcp-adapter/mcp-adapter.php"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": "/wordpress/wp-content/plugins/hm-rest-ability/.playground-debug.log",
				"SCRIPT_DEBUG": true
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/test-application-passwords.php",
			"data": "<?php\n/**\n * Test-only: makes application passwords usable in Playground.\n *\n * WordPress only offers them over SSL or on localhost, and Playground serves\n * over http://127.0.0.1.\n */\n\ndefine( 'HM_TEST_APP_PASSWORDS', true );\n\nadd_filter( 'wp_is_application_passwords_available', '__return_true' );\n"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "hm-rest-ability/hm-rest-ability.php",
			"pluginName": "HM REST Ability"
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n$user = get_user_by( 'login', 'admin' );\nlist( $password ) = WP_Application_Passwords::create_new_application_password( $user->ID, [ 'name' => 'e2e-tests' ] );\nfile_put_contents(\n\t'/wordpress/wp-content/plugins/hm-rest-ability/.playground-credentials.json',\n\tjson_encode( [ 'user' => $user->user_login, 'password' => $password ] )\n);"
		}
	]
}
