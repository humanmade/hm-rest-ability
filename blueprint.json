{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "6.9"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/archive/refs/tags/v0.6.1.zip"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php rename( '/wordpress/wp-content/plugins/mcp-adapter-0.6.1', '/wordpress/wp-content/plugins/mcp-adapter' );"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "mcp-adapter/mcp-adapter.php"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"SCRIPT_DEBUG": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "hm-rest-ability/hm-rest-ability.php",
			"pluginName": "HM REST Ability"
		}
	]
}
