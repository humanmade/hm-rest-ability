{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "6.9"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "HM REST Ability"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/archive/refs/tags/v0.6.1.zip"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php rename( '/wordpress/wp-content/plugins/mcp-adapter-0.6.1', '/wordpress/wp-content/plugins/mcp-adapter' );"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "mcp-adapter/mcp-adapter.php"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"SCRIPT_DEBUG": true
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/test-application-passwords.php",
			"data": "<?php\n/**\n * Test-only: makes application passwords usable in Playground.\n *\n * WordPress only offers them over SSL or on localhost, and Playground serves\n * over http://127.0.0.1. The Authorization header is also re-populated,\n * because some PHP server setups drop it before WordPress sees it.\n */\n\nadd_filter( 'wp_is_application_passwords_available', '__return_true' );\n\nif ( empty( $_SERVER['HTTP_AUTHORIZATION'] ) && function_exists( 'getallheaders' ) ) {\n\tforeach ( getallheaders() as $name => $value ) {\n\t\tif ( strtolower( $name ) === 'authorization' ) {\n\t\t\t$_SERVER['HTTP_AUTHORIZATION'] = $value;\n\t\t\tbreak;\n\t\t}\n\t}\n}\n"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "hm-rest-ability/hm-rest-ability.php",
			"pluginName": "HM REST Ability"
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\n$user = get_user_by( 'login', 'admin' );\nlist( $password ) = WP_Application_Passwords::create_new_application_password( $user->ID, [ 'name' => 'e2e-tests' ] );\nfile_put_contents(\n\t'/wordpress/wp-content/plugins/hm-rest-ability/.playground-credentials.json',\n\tjson_encode( [ 'user' => $user->user_login, 'password' => $password ] )\n);"
		}
	]
}
